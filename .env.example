# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public HTTPS origin used for production payment callbacks and webhook settings.
APP_URL=""
# HTTPS origin that receives payment and messaging webhooks. Defaults to APP_URL.
SAQO_API_ORIGIN=""
# On the Vercel production project, set the public API origin and customer site origin.
VITE_SAQO_API_ORIGIN=""
SAQO_FRONTEND_ORIGIN=""

# VITE_MAPBOX_TOKEN: Optional Mapbox public access token (pk.*) for Mapbox tile layer overlay.
# Without it, SAQO renders its built-in high-contrast OpenStreetMap/Carto street map.
VITE_MAPBOX_TOKEN=""

# Optional Photon autocomplete endpoint and OSRM driving route base URL.
# Set these to your hosted providers for production traffic.
VITE_PHOTON_URL=""
VITE_OSRM_URL=""

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY: Optional Supabase Realtime configuration
# for pushing live notifications across Supabase Realtime channels alongside WebSockets.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Required in production. Supply a random secret of at least 32 characters.
SAQO_SESSION_SECRET=""

# Initial admin credentials for a new production database.
SAQO_ADMIN_EMAIL=""
SAQO_ADMIN_PASSWORD=""

# Set this to a file on a persistent volume in production.
SAQO_DB_PATH=""

# Docker Compose expects the public hostname without the https:// prefix.
SAQO_DOMAIN=""
SAQO_BACKUP_INTERVAL_SECONDS=21600
SAQO_BACKUP_RETAIN=28
SAQO_DISPATCH_ALERT_SECONDS=300

# Optional HTTPS endpoint that accepts SAQO alert JSON and returns HTTP 2xx.
SAQO_ALERT_WEBHOOK_URL=""
SAQO_ALERT_WEBHOOK_TOKEN=""

# Optional Twilio WhatsApp integration. Requires APP_URL to be a public HTTPS URL.
# Set the sender's incoming-message webhook to POST /api/webhooks/twilio/whatsapp.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
# Optional HTTPS API origin when Twilio calls a different host from APP_URL.
TWILIO_WEBHOOK_ORIGIN=""
